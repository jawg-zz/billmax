# =============================================================================
# BillMax — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values.
# Settings configured via the admin UI (Settings page) override these defaults.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=BillMax
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET=change-me-to-another-random-secret
JWT_LIFETIME_SECONDS=3600
JWT_REFRESH_LIFETIME_SECONDS=604800
CORS_ORIGINS=["http://localhost:5173", "https://billmax.yourdomain.com"]
SENTRY_DSN=
PORTAL_URL=https://billmax.yourdomain.com/portal

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://billmax:billmax@billmax-db:5432/billmax
REDIS_URL=redis://billmax-redis:6379/0

# ── M-Pesa (Safaricom) ──────────────────────────────────────────────────────
# These can also be configured via the admin Settings UI.
# Get sandbox credentials at https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_ENVIRONMENT=sandbox
# Must be a public HTTPS URL reachable by Safaricom
MPESA_CALLBACK_URL=https://billmax.yourdomain.com/api/v1/mpesa/stk-callback

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Used for sending invoices, dunning notices, welcome emails, admin alerts.
# Also configurable via the admin Settings UI.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=BillMax <noreply@yourdomain.com>
NOTIFICATION_EMAIL=admin@yourdomain.com

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Used for dunning notices and welcome fallback when customer has no email.
# Also configurable via the admin Settings UI.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://api.whatsapp.com/v1/messages
WHATSAPP_API_KEY=

# ── Network Provisioning ─────────────────────────────────────────────────────
# Choose: "mock" (no-op), "routeros" (MikroTik), "freeradius", or "both"
# Also configurable via the admin Settings UI.
PROVISIONING_BACKEND=mock

# MikroTik RouterOS
ROUTEROS_HOST=
ROUTEROS_PORT=8728
ROUTEROS_USERNAME=admin
ROUTEROS_PASSWORD=

# FreeRADIUS (separate RADIUS database — leave empty to use main DB)
RADIUS_DATABASE_URL=

# ── Celery ───────────────────────────────────────────────────────────────────
# Schedules run automatically when Celery beat is running:
#   - Daily billing run:    02:00
#   - Overdue processing:   06:00
#   - M-Pesa reconciliation:every hour at :30
#   - FUP enforcement:     every 4 hours
#
# Start workers:
#   celery -A app.celery_app worker --loglevel=info
#   celery -A app.celery_app beat --loglevel=info
#
# Or combine (single container):
#   celery -A app.celery_app worker --beat --loglevel=info
